# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate a secret:            openssl rand -base64 48
# Generate TC_ENCRYPTION_KEY:   openssl rand -base64 32

# --- Database and Redis passwords (used by docker-compose to create the roles) ---------------------
POSTGRES_PASSWORD=CHANGE_ME
TC_DB_OWNER_PASSWORD=CHANGE_ME
TC_DB_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Ports on your machine. Pick others if these are taken (e.g. a local PostgreSQL already uses 5432).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
MAILPIT_HOST_PORT=8025

# --- Application ------------------------------------------------------------------------------------
TC_ENVIRONMENT=dev

# JWT signing keys as JSON {"key id": "secret"}; each secret at least 32 characters.
# To rotate: add a new key, point TC_JWT_ACTIVE_KID at it, remove the old one after a day.
TC_JWT_KEYS={"2026-10": "CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS"}
TC_JWT_ACTIVE_KID=2026-10

# Encrypts secrets stored in the database (two-factor secrets, provider credentials).
# base64 of exactly 32 random bytes. Losing it makes those secrets unreadable: back it up.
TC_ENCRYPTION_KEY=CHANGE_ME

# Platform (super) admin created on first start. Sign in on the dashboard with these.
# Never changes an existing admin; remove these lines after the first start if you like.
TC_SEED_ADMIN_EMAIL=admin@example.com
TC_SEED_ADMIN_PASSWORD=CHANGE_ME

# Address of the admin dashboard, used for links in emails (invitations, password resets).
# Can be changed later in the platform settings.
TC_PUBLIC_URL=http://localhost:5173

# Uploads: size limit per file and default storage quota per tenant (both changeable per tenant
# in the files module options). Files are stored on local disk until S3/R2 is set in the dashboard.
TC_FILE_MAX_MB=20
TC_FILE_QUOTA_MB=1024

# Two-factor sign-in for platform admins: required in production by default.
# TC_PLATFORM_MFA_REQUIRED=true

# Rate limits (requests per minute)
TC_RL_LOGIN_PER_MIN=10
TC_RL_PRINCIPAL_PER_MIN=300
TC_RL_TENANT_DEFAULT_PER_MIN=1200
TC_RL_TENANT_MAX_PER_MIN=12000

# Browser origins allowed to call the API directly, comma-separated (not needed when the dashboard
# is served from the same domain).
# TC_CORS_ORIGINS=https://admin.example.com

# Webhooks: request timeout. Webhooks can only reach public https addresses; set
# TC_WEBHOOKS_ALLOW_PRIVATE=true only on a development machine to test against localhost.
TC_WEBHOOKS_TIMEOUT_S=10
# TC_WEBHOOKS_ALLOW_PRIVATE=false

# Delivery tracking: how long driver location history is kept.
TC_PING_RETENTION_DAYS=30

# Geocoding: cache lifetime and how many provider calls one tenant may make per minute.
# OpenStreetMap Nominatim is the free default (light use only); a tenant can switch to Google with
# its own key in the dashboard.
TC_GEOCODE_CACHE_DAYS=30
TC_MAPS_CALLS_PER_MIN=60

# Backups (the "backup" service): how often, and how many days to keep. The dashboard flags the
# backups as late after two intervals without one.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
