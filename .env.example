# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- docker-compose bootstrap --------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
TC_OWNER_PASSWORD=CHANGE_ME
TC_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- application -----------------------------------------------------------------------------------
TC_ENVIRONMENT=dev
TC_API_PREFIX=/api/v1
TC_LOG_LEVEL=INFO
TC_LOG_JSON=true

# Runtime role (NOSUPERUSER, NOBYPASSRLS) and schema-owner role. Set by docker-compose for the stack;
# set them here when running uvicorn directly.
# TC_DATABASE_URL=postgresql+asyncpg://tc_app:PASSWORD@localhost:5432/tenantcore
# TC_DDL_DATABASE_URL=postgresql+asyncpg://tc_owner:PASSWORD@localhost:5432/tenantcore
TC_APP_DB_ROLE=tc_app
TC_DB_STATEMENT_TIMEOUT_MS=5000
TC_DB_PGBOUNCER_MODE=false
TC_SLOW_QUERY_MS=200

# TC_REDIS_URL=redis://:PASSWORD@localhost:6379/0

# JWT signing keys as JSON {kid: secret}; >= 32 bytes each. Keep the previous key listed until its
# tokens expire (refresh TTL) when rotating.
TC_JWT_KEYS={"2026-10": "CHANGE_ME_AT_LEAST_32_BYTES_RANDOM"}
TC_JWT_ACTIVE_KID=2026-10
TC_JWT_ISSUER=tenantcore
TC_ACCESS_TTL_S=600
TC_REFRESH_TTL_S=1209600

# HMAC pepper for API key digests (>= 32 bytes). Rotating it invalidates all API keys.
TC_API_KEY_PEPPER=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
TC_API_KEY_CACHE_TTL_S=60

# Rate limits (requests/minute)
TC_RL_PLATFORM_PER_MIN=60000
TC_RL_TENANT_DEFAULT_PER_MIN=1200
TC_RL_TENANT_MAX_PER_MIN=12000
TC_RL_PRINCIPAL_PER_MIN=300
TC_RL_LOGIN_PER_MIN=10
TC_RL_LOCAL_FALLBACK_DIVISOR=4

TC_MAX_REQUEST_BYTES=1048576
TC_MAX_PAGE_SIZE=200

# --- Platform administration ------------------------------------------------------------------------
# Request-serving deployments: set TC_ENABLE_PLATFORM_ROUTES=false and leave TC_DDL_DATABASE_URL unset.
TC_ENABLE_PLATFORM_ROUTES=true
# TOTP for platform admins; defaults to required when TC_ENVIRONMENT=production.
# TC_PLATFORM_MFA_REQUIRED=true

# --- Envelope encryption (provider credentials, tenant DB passwords, MFA secrets) -------------------
# local (dev only) | vault | aws
TC_KMS_PROVIDER=local
# TC_KMS_LOCAL_KEK=<base64 of 32 random bytes>   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# TC_VAULT_ADDR=https://vault.internal:8200
# TC_VAULT_TOKEN=CHANGE_ME
# TC_VAULT_TRANSIT_KEY=tenantcore
# TC_AWS_KMS_KEY_ID=alias/tenantcore
# TC_AWS_REGION=ap-southeast-1

# Additional API key peppers for rotation, and which one new keys use.
# TC_API_KEY_PEPPERS={"p2": "CHANGE_ME_AT_LEAST_32_BYTES_RANDOM"}
# TC_API_KEY_ACTIVE_PEPPER=p2

# --- Integrations ----------------------------------------------------------------------------------
TC_OUTBOUND_TIMEOUT_S=10
# Sandbox payment provider (never available in production).
# TC_SANDBOX_PAYMENTS_ENABLED=true

# --- Dedicated tenant databases ----------------------------------------------------------------------
# CIDRs dedicated database hosts may resolve to. Empty disables the feature.
TC_TENANT_DB_ALLOWED_NETWORKS=[]
TC_TENANT_DB_MAX_ENGINES=50
TC_TENANT_DB_POOL_SIZE=3


# --- Background jobs (Celery) ------------------------------------------------------------------------
# Use a separate Redis database (or instance) from the cache. Set by docker-compose for the stack.
# TC_CELERY_BROKER_URL=redis://:PASSWORD@localhost:6379/1
TC_CELERY_TASK_SOFT_TIME_LIMIT_S=300
TC_CELERY_TASK_TIME_LIMIT_S=360
TC_CELERY_MAX_RETRIES=5

# --- Webhooks, push notifications, imports ------------------------------------------------------------
TC_WEBHOOK_MAX_ATTEMPTS=10
TC_WEBHOOK_DISABLE_AFTER_FAILURES=50
TC_WEBHOOK_ALLOWED_PORTS=[443]
TC_NOTIFICATION_MAX_ATTEMPTS=5
# Firebase Cloud Messaging service account (JSON, from your secret manager). Push is disabled without it.
# TC_FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# TC_FCM_PROJECT_ID=my-project
TC_IMPORT_MAX_BYTES=10485760
TC_IMPORT_MAX_ROWS=50000
TC_FILE_RETENTION_DAYS=7
TC_PING_RETENTION_DAYS=90

# --- Offboarding archives -------------------------------------------------------------------------------
# local (dev; envelope-encrypted files) | s3 (SSE-KMS)
TC_ARCHIVE_STORE=local
TC_ARCHIVE_DIR=./archives
# TC_ARCHIVE_S3_BUCKET=tenantcore-archives
# TC_ARCHIVE_S3_PREFIX=tenant-archives/
# TC_ARCHIVE_S3_KMS_KEY_ID=alias/tenantcore-archives

# --- OpenTelemetry ----------------------------------------------------------------------------------------
TC_OTEL_ENABLED=false
TC_OTEL_EXPORTER_ENDPOINT=http://localhost:4318
TC_OTEL_SAMPLE_RATIO=0.1
