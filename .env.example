# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- docker-compose bootstrap --------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME
TC_OWNER_PASSWORD=CHANGE_ME
TC_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# --- application -----------------------------------------------------------------------------------
TC_ENVIRONMENT=dev
TC_API_PREFIX=/api/v1
TC_LOG_LEVEL=INFO
TC_LOG_JSON=true

# Runtime role (NOSUPERUSER, NOBYPASSRLS) and schema-owner role. Set by docker-compose for the stack;
# set them here when running uvicorn directly.
# TC_DATABASE_URL=postgresql+asyncpg://tc_app:PASSWORD@localhost:5432/tenantcore
# TC_DDL_DATABASE_URL=postgresql+asyncpg://tc_owner:PASSWORD@localhost:5432/tenantcore
TC_APP_DB_ROLE=tc_app
TC_DB_STATEMENT_TIMEOUT_MS=5000
TC_DB_PGBOUNCER_MODE=false
TC_SLOW_QUERY_MS=200

# TC_REDIS_URL=redis://:PASSWORD@localhost:6379/0

# JWT signing keys as JSON {kid: secret}; >= 32 bytes each. Keep the previous key listed until its
# tokens expire (refresh TTL) when rotating.
TC_JWT_KEYS={"2026-10": "CHANGE_ME_AT_LEAST_32_BYTES_RANDOM"}
TC_JWT_ACTIVE_KID=2026-10
TC_JWT_ISSUER=tenantcore
TC_ACCESS_TTL_S=600
TC_REFRESH_TTL_S=1209600

# HMAC pepper for API key digests (>= 32 bytes). Rotating it invalidates all API keys.
TC_API_KEY_PEPPER=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM
TC_API_KEY_CACHE_TTL_S=60

# Rate limits (requests/minute)
TC_RL_PLATFORM_PER_MIN=60000
TC_RL_TENANT_DEFAULT_PER_MIN=1200
TC_RL_TENANT_MAX_PER_MIN=12000
TC_RL_PRINCIPAL_PER_MIN=300
TC_RL_LOGIN_PER_MIN=10
TC_RL_LOCAL_FALLBACK_DIVISOR=4

TC_MAX_REQUEST_BYTES=1048576
TC_MAX_PAGE_SIZE=200
