# Use built-in sample data (true) or call the real FastAPI backend (false).
VITE_USE_MOCKS=true
# API base path. With `npm run dev` the Vite proxy forwards /api to http://localhost:8000.
VITE_API_BASE=/api/v1
# "history" for clean URLs (needs a server fallback to index.html), "hash" for static hosting,
# "memory" for embedded previews.
VITE_ROUTER_MODE=history
